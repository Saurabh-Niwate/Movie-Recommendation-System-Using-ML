# CineMatch Movie Recommendation System - Environment Variables

# Database Configuration (PostgreSQL / Automatic SQLite fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=cinematch
DB_SCHEMA=cinematch

# SQLite Fallback (automatically active when PostgreSQL is unavailable)
SQLITE_DB_PATH=cinematch.db
DB_FALLBACK_SQLITE=true

# TMDB (The Movie Database) API Configuration
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# JWT Authentication Secret Key
JWT_SECRET=cinematch_super_secret_jwt_key_2026_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
